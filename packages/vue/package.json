{
  "name": "@enchantforge/vue",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/enchantforge-vue.js",
  "module": "./dist/enchantforge-vue.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/enchantforge-vue.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/enchantforge-vue.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./enchant": {
      "types": "./dist/enchant.d.ts",
      "import": "./dist/enchant.js"
    },
    "./aura": {
      "types": "./dist/aura.d.ts",
      "import": "./dist/aura.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    },
    "./style.css": "./dist/enchantforge-vue.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly",
    "test": "vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "ant-design-x-vue": "^1.6.0",
    "marked": "14.0.0"
  }
}
