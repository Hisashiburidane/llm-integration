{
  "name": "copilotkit-vue-validation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -k -n runtime,web -c blue,green \"pnpm dev:runtime\" \"pnpm dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5190",
    "dev:runtime": "tsx watch server/server.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.86",
    "@copilotkit/runtime": "1.63.1",
    "@copilotkit/vue": "1.63.1",
    "ai": "6.0.230",
    "ant-design-vue": "4.2.6",
    "dotenv": "17.2.3",
    "echarts": "6.1.0",
    "vue": "3.5.40",
    "vue-echarts": "8.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@vitejs/plugin-vue": "5.2.4",
    "concurrently": "9.1.2",
    "tsx": "4.19.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vue-tsc": "2.2.12"
  }
}
